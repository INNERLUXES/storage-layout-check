{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "storage-layout-check",
          "version": "1.0.0",
          "informationUri": "https://github.com/INNERLUXES/storage-layout-check",
          "rules": [
            {
              "id": "layout-unreadable",
              "name": "layout-unreadable",
              "shortDescription": {
                "text": "a file is not JSON the reader can follow, or holds no storage layout in a form the tool reads (a layout object, an artifact with storageLayout, a compiler output with contracts)"
              },
              "help": {
                "text": "Give the storage layout as the compiler, forge inspect or an artifact writes it (docs/inputs.md), and fix the line named. (input)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "input"
              }
            },
            {
              "id": "layout-incomplete",
              "name": "layout-incomplete",
              "shortDescription": {
                "text": "a variable or a type of a layout lacks what the comparison needs (a label, slot, offset or type, a size, a type that is not in types); that part was not compared"
              },
              "help": {
                "text": "Give the layout as the compiler writes it, or compare that part by hand. (input)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "input"
              }
            },
            {
              "id": "variable-removed",
              "name": "variable-removed",
              "shortDescription": {
                "text": "a variable of the old layout is not in the new one, under its name or at its place"
              },
              "help": {
                "text": "Keep the variable at its place, under its old name or a new one; if it is no longer used, leave it declared and unused. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "variable-moved",
              "name": "variable-moved",
              "shortDescription": {
                "text": "a variable is at another slot or offset in the new layout"
              },
              "help": {
                "text": "Declare the variables in the old order and keep every base contract as it was; add new variables after the last one, or take their slots from a gap. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "type-changed",
              "name": "type-changed",
              "shortDescription": {
                "text": "a variable keeps its name and gets a type with another storage form: another size or signedness, another mapping key or value, other struct members, another array length, or enum members removed or reordered"
              },
              "help": {
                "text": "Keep the old type; add a variable of the new type after the last one and move the data in an upgrade step. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "variable-inserted",
              "name": "variable-inserted",
              "shortDescription": {
                "text": "a new variable takes storage that a variable of the old layout used, as happens when it is declared before existing ones or in a base contract with no room"
              },
              "help": {
                "text": "Declare new variables after the last one, or in a base contract take their slots from its gap. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "gap-mismatch",
              "name": "gap-mismatch",
              "shortDescription": {
                "text": "the slots added before a storage gap in a contract are not the slots the gap was cut by, so what follows the gap moves"
              },
              "help": {
                "text": "Cut the gap by exactly the slots the new variables take, counting how they pack. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "gap-removed",
              "name": "gap-removed",
              "shortDescription": {
                "text": "a contract that had a storage gap has none in the new layout"
              },
              "help": {
                "text": "Keep a gap in every base contract that may grow; drop it only when the variables that replace it take exactly its slots. (best practice)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "best practice"
              }
            },
            {
              "id": "inheritance-order-changed",
              "name": "inheritance-order-changed",
              "shortDescription": {
                "text": "the contracts that hold storage come in another order in the new layout"
              },
              "help": {
                "text": "Keep the base contracts in their old order; a new base contract with storage needs room that does not move the others, such as a namespace. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "namespace-removed",
              "name": "namespace-removed",
              "shortDescription": {
                "text": "an ERC-7201 namespace of the old layout is not in the new one"
              },
              "help": {
                "text": "Keep the namespace struct with its annotation and its members, even those no longer used. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "proxy-slot-overlap",
              "name": "proxy-slot-overlap",
              "shortDescription": {
                "text": "a variable of the new layout takes a slot that ERC-1967 sets aside for a proxy (the logic contract, the beacon or the admin)"
              },
              "help": {
                "text": "Move the variable, or the base slot of a custom layout, away from the ERC-1967 slots. (documented)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "variable-renamed",
              "name": "variable-renamed",
              "shortDescription": {
                "text": "a variable of the old layout has a new name, or is declared in another contract, at the same slot and offset with the same storage form, so it keeps the old value"
              },
              "help": {
                "text": "Confirm that the variable means the same as before, since it starts with the old value. (documented)"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "kind": "documented"
              }
            },
            {
              "id": "type-renamed",
              "name": "type-renamed",
              "shortDescription": {
                "text": "a variable keeps its place and its storage form under another type name: a contract type and address, string and bytes, a renamed struct or enum, a user-defined value type"
              },
              "help": {
                "text": "Confirm that the stored values mean the same under the new type. (best practice)"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "kind": "best practice"
              }
            },
            {
              "id": "type-extended",
              "name": "type-extended",
              "shortDescription": {
                "text": "members were appended to a struct stored as a mapping value or within its old size, or to an enum, and what was stored keeps its place"
              },
              "help": {
                "text": "Confirm that the code handles what was stored before the upgrade: appended struct members read as zero there. (best practice)"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "kind": "best practice"
              }
            }
          ]
        }
      },
      "artifacts": [
        {
          "location": {
            "uri": "examples/v1/layout.json"
          }
        },
        {
          "location": {
            "uri": "examples/v2-bad/layout.json"
          }
        }
      ],
      "results": [
        {
          "ruleId": "variable-removed",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "Vault.paused (bool) at slot 113, offset 0 is not in the new layout, under its name or at its place. Its value stays in storage, and a variable that takes its place starts with that value. A variable turned into a constant or an immutable leaves storage too. Fix: Keep the variable at its place, under its old name or a new one; if it is no longer used, leave it declared and unused."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/v1/layout.json",
                  "index": 0
                },
                "region": {
                  "startLine": 86,
                  "startColumn": 16
                }
              }
            }
          ],
          "properties": {
            "kind": "documented",
            "side": "old"
          }
        },
        {
          "ruleId": "namespace-removed",
          "ruleIndex": 9,
          "level": "error",
          "message": {
            "text": "The namespace erc7201:example.vault.legacy of the old layout (1 variable) is not in the new one. Its values stay in storage, and a namespace with the same id added later starts with them. Fix: Keep the namespace struct with its annotation and its members, even those no longer used."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/v1/layout.json",
                  "index": 0
                },
                "region": {
                  "startLine": 316,
                  "startColumn": 5
                }
              }
            }
          ],
          "properties": {
            "kind": "documented",
            "side": "old"
          }
        },
        {
          "ruleId": "inheritance-order-changed",
          "ruleIndex": 8,
          "level": "error",
          "message": {
            "text": "The contracts that hold storage come in the order AccessBase, FeeBase, ListBase and Vault in the old layout and AccessBase, ListBase, FeeBase and Vault in the new one. Their variables are laid out in the order of the base contracts, so the variables of the contracts that changed place move. Fix: Keep the base contracts in their old order; a new base contract with storage needs room that does not move the others, such as a namespace."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/v2-bad/layout.json",
                  "index": 1
                },
                "region": {
                  "startLine": 30,
                  "startColumn": 16
                }
              }
            }
          ],
          "properties": {
            "kind": "documented",
            "side": "new"
          }
        },
        {
